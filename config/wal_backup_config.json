{
  "strategy_version": "1.0.0",
  "implementation_date": "2026-02-28T18:46:47.396953Z",
  "backup_configuration": {
    "enabled": true,
    "database_path": "~/.kiva/global_wal.db",
    "backup_locations": [
      {
        "type": "local",
        "path": "~/.kiva/backups/wal",
        "retention_days": 30,
        "compression": true,
        "encryption": false
      },
      {
        "type": "remote_github",
        "repository": "gerivdb/ECOYSTEM",
        "path": "backups/wal",
        "branch": "main",
        "retention_days": 90,
        "compression": true,
        "encryption": false
      }
    ],
    "backup_schedule": {
      "frequency": "daily",
      "time": "02:00",
      "timezone": "UTC",
      "max_parallel_backups": 2
    }
  },
  "backup_types": [
    {
      "name": "full_backup",
      "frequency": "daily",
      "retention_count": 7,
      "compression_level": 9,
      "includes": [
        "all_tables",
        "schema",
        "indexes"
      ]
    },
    {
      "name": "incremental_backup",
      "frequency": "hourly",
      "retention_count": 24,
      "compression_level": 6,
      "includes": [
        "new_entries_only"
      ]
    },
    {
      "name": "snapshot_backup",
      "frequency": "weekly",
      "retention_count": 4,
      "compression_level": 9,
      "includes": [
        "complete_database_state"
      ]
    }
  ],
  "restore_procedures": {
    "restore_from_local": {
      "command": "ecos wal restore --source local --backup-id {backup_id}",
      "verification": "automatic",
      "rollback_on_error": true
    },
    "restore_from_remote": {
      "command": "ecos wal restore --source github --backup-id {backup_id}",
      "verification": "automatic",
      "rollback_on_error": true
    },
    "point_in_time_recovery": {
      "enabled": true,
      "granularity": "hourly",
      "max_recovery_window_days": 30
    }
  },
  "monitoring": {
    "enabled": true,
    "metrics": [
      "backup_success_rate",
      "backup_duration",
      "backup_size",
      "restore_test_results",
      "storage_usage"
    ],
    "alerts": [
      {
        "condition": "backup_failure",
        "severity": "HIGH",
        "notification_channels": [
          "github_issue"
        ]
      },
      {
        "condition": "storage_threshold_exceeded",
        "threshold": "80%",
        "severity": "MEDIUM",
        "notification_channels": [
          "github_issue"
        ]
      }
    ]
  },
  "validation": {
    "automatic_restore_testing": {
      "enabled": true,
      "frequency": "weekly",
      "sample_size": "latest_3_backups"
    },
    "integrity_checks": {
      "enabled": true,
      "frequency": "daily",
      "checks": [
        "checksum",
        "schema_validation",
        "data_consistency"
      ]
    }
  }
}