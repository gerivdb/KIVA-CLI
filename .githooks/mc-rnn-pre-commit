#!/usr/bin/env python3
"""
pre-commit hook for MC-RNN repos.
Validates staged Python files with diffscope fingerprint checks.

Install: copy to .githooks/pre-commit in any MC-RNN repo.

Checks:
  1. No merge conflict markers in staged files
  2. No emojis in staged Python files (ASCII-only for MC-RNN)
  3. Files end with exactly one newline
  4. Python syntax validation (py_compile)
  5. diffscope fingerprint check (if diffscope binary available)
"""

import sys
import os
import subprocess
import re
from pathlib import Path

REPO_ROOT = Path.cwd()

def get_staged_files():
    """Return list of staged files."""
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only"],
        capture_output=True, text=True, cwd=str(REPO_ROOT)
    )
    return [f for f in result.stdout.strip().split("\n") if f]

def check_merge_conflicts(files):
    """Reject merge conflict markers."""
    conflicts = []
    for f in files:
        fp = REPO_ROOT / f
        if not fp.is_file():
            continue
        try:
            content = fp.read_text(encoding="utf-8")
            if any(marker in content for marker in ["<<<<<<< ", "=======", ">>>>>>> "]):
                conflicts.append(f)
        except (UnicodeDecodeError, PermissionError):
            pass
    if conflicts:
        print("ERROR: Merge conflict markers found:")
        for f in conflicts:
            print(f"  {f}")
        return False
    return True

def check_no_emojis(files):
    """Reject non-ASCII characters (emojis) in Python files."""
    # Unicode ranges for common emoji blocks
    emoji_pattern = re.compile(
        "["
        "\U0001F600-\U0001F64F"  # emoticons
        "\U0001F300-\U0001F5FF"  # symbols & pictographs
        "\U0001F680-\U0001F6FF"  # transport & map
        "\U0001F1E0-\U0001F1FF"  # flags
        "\U00002702-\U000027B0"  # dingbats
        "\U000024C2-\U0001F251"  # enclosed
        "\U0001F900-\U0001F9FF"  # supplemental symbols
        "\U0001FA00-\U0001FA6F"  # chess symbols
        "\U0001FA70-\U0001FAFF"  # symbols extended
        "\U00002600-\U000026FF"  # misc symbols
        "\U0000FE00-\U0000FE0F"  # variation selectors
        "\U0000200D"              # zero width joiner
        "]+",
        flags=re.UNICODE
    )
    violations = []
    for f in files:
        if not f.endswith(".py"):
            continue
        fp = REPO_ROOT / f
        if not fp.is_file():
            continue
        try:
            content = fp.read_text(encoding="utf-8")
            matches = emoji_pattern.findall(content)
            if matches:
                # Find line numbers
                for i, line in enumerate(content.split("\n"), 1):
                    if emoji_pattern.search(line):
                        violations.append(f"{f}:{i}")
        except (UnicodeDecodeError, PermissionError):
            pass
    if violations:
        print("ERROR: Emojis/non-ASCII found in Python files:")
        for v in violations:
            print(f"  {v}")
        return False
    return True

def check_trailing_newline(files):
    """Ensure text files end with exactly one newline."""
    skip_ext = re.compile(r'\.(png|jpg|jpeg|gif|ico|pdf|bin|wasm|woff2?|ttf|eot|otf|zip|gz|sqlite|db|pyc)$')
    violations = []
    for f in files:
        if skip_ext.search(f):
            continue
        fp = REPO_ROOT / f
        if not fp.is_file():
            continue
        try:
            content = fp.read_bytes()
            if not content:
                continue
            if not content.endswith(b"\n"):
                violations.append(f)
            elif content.endswith(b"\n\n"):
                violations.append(f"{f} (double newline)")
        except (PermissionError, OSError):
            pass
    if violations:
        print("ERROR: Files must end with exactly one newline:")
        for v in violations:
            print(f"  {v}")
        return False
    return True

def check_python_syntax(files):
    """Validate Python syntax for staged .py files."""
    import py_compile
    errors = []
    for f in files:
        if not f.endswith(".py"):
            continue
        fp = REPO_ROOT / f
        if not fp.is_file():
            continue
        try:
            py_compile.compile(str(fp), doraise=True)
        except py_compile.PyCompileError as e:
            errors.append(f"{f}: {e}")
    if errors:
        print("ERROR: Python syntax errors:")
        for e in errors:
            print(f"  {e}")
        return False
    return True

def check_diffscope_fingerprint(files):
    """
    Run diffscope fingerprint check if binary available.
    Non-blocking: warns but doesn't fail the commit.
    """
    # Look for diffscope binary
    diffscope_paths = [
        Path(r"D:\DO\WEB\TOOLS\L4-TOOLS\diffscope-fork\target\release\diffscope.exe"),
        Path(r"D:\DO\WEB\TOOLS\L4-TOOLS\diffscope-fork\target\debug\diffscope.exe"),
        Path("diffscope"),  # in PATH
    ]
    diffscope_bin = None
    for p in diffscope_paths:
        if p == Path("diffscope"):
            result = subprocess.run(["where", "diffscope"], capture_output=True, text=True)
            if result.returncode == 0:
                diffscope_bin = "diffscope"
                break
        elif p.exists():
            diffscope_bin = str(p)
            break

    if not diffscope_bin:
        print("  [diffscope] Binary not found — skipping fingerprint check")
        return True

    # Only check Python files
    py_files = [f for f in files if f.endswith(".py")]
    if not py_files:
        return True

    try:
        result = subprocess.run(
            [diffscope_bin, "review", "--diff", "--format", "json"],
            capture_output=True, text=True, timeout=30, cwd=str(REPO_ROOT)
        )
        if result.returncode != 0 and "no diff" not in result.stderr.lower():
            print(f"  [diffscope] Warning: {result.stderr[-200:]}")
            # Non-blocking
    except subprocess.TimeoutExpired:
        print("  [diffscope] Timeout — skipping")
    except Exception as e:
        print(f"  [diffscope] Error: {e} — skipping")

    return True


def main():
    files = get_staged_files()
    if not files:
        sys.exit(0)

    print(f"[mc-rnn pre-commit] Checking {len(files)} staged file(s)...")

    checks = [
        ("merge conflicts", check_merge_conflicts),
        ("no emojis", check_no_emojis),
        ("trailing newline", check_trailing_newline),
        ("python syntax", check_python_syntax),
        ("diffscope fingerprint", check_diffscope_fingerprint),
    ]

    all_ok = True
    for name, fn in checks:
        result = fn(files)
        status = "OK" if result else "FAIL"
        print(f"  [{status}] {name}")
        if not result and name != "diffscope fingerprint":
            all_ok = False

    if all_ok:
        print("[mc-rnn pre-commit] All checks passed.")
        sys.exit(0)
    else:
        print("[mc-rnn pre-commit] Commit rejected. Fix issues above.")
        sys.exit(1)


if __name__ == "__main__":
    main()
