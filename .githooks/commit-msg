#!/usr/bin/env bash
# ============================================================
# commit-msg — Validate Conventional Commits format
# .githooks/commit-msg
# IntentHash: 0xCOMMIT_MSG_VALIDATOR_20260626
# ============================================================

COMMIT_MSG_FILE="${1}"
COMMIT_MSG=$(cat "${COMMIT_MSG_FILE}")

# Patterns valides
VALID_PATTERN="^(feat|fix|refactor|docs|chore|adr|break|test|style|wip)(\(.+\))?: .{1,72}"

# Ignorer les messages de merge (tout format)
if echo "${COMMIT_MSG}" | grep -qE "^Merge "; then
    exit 0
fi

# Ignorer les messages de revert
if echo "${COMMIT_MSG}" | grep -qE "^Revert "; then
    exit 0
fi

# Première ligne du message
FIRST_LINE=$(echo "${COMMIT_MSG}" | head -1)

# Vérifier le format
if ! echo "${FIRST_LINE}" | grep -qE "${VALID_PATTERN}"; then
    echo ""
    echo "[COMMIT-MSG BLOCK] Message non conforme au format Conventional Commits"
    echo ""
    echo "Format: <type>(<scope>): <description>"
    echo ""
    echo "Types valides: feat | fix | refactor | docs | chore | adr | break | test | style | wip"
    echo ""
    echo "Votre message: ${FIRST_LINE}"
    echo ""
    echo "Pour forcer: git commit --no-verify"
    exit 1
fi

# Vérifier la longueur de la première ligne
if [ "${#FIRST_LINE}" -gt 72 ]; then
    echo ""
    echo "[COMMIT-MSG WARN] Première ligne trop longue (${#FIRST_LINE} chars, max 72)"
fi
