#!/usr/bin/env bash
# ============================================================
# pre-commit — Unified: secrets + encoding + large files
# .githooks/pre-commit
# IntentHash: 0xPRE_COMMIT_UNIFIED_20260626
# ============================================================

echo "[PRE-COMMIT] Running checks..."

# --- Check 1: Secret scanning ---
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

if [ -n "${STAGED_FILES}" ]; then
    # Patterns de secrets
    SECRET_PATTERNS='AKIA[0-9A-Z]{16}|ghp_[a-zA-Z0-9]{36}|gho_[a-zA-Z0-9]{36}|sk-[a-zA-Z0-9]{32,}|-----BEGIN (RSA |EC |DSA )?PRIVATE KEY-----'

    for file in ${STAGED_FILES}; do
        if [ -f "${file}" ]; then
            MATCH=$(grep -Pn "${SECRET_PATTERNS}" "${file}" 2>/dev/null || true)
            if [ -n "${MATCH}" ]; then
                echo ""
                echo "[PRE-COMMIT BLOCK] Secret detected in ${file}:"
                echo "${MATCH}"
                echo ""
                echo "Remove the secret or use git commit --no-verify (NOT RECOMMENDED)"
                exit 1
            fi
        fi
    done
fi

# --- Check 2: .env files should not be committed ---
ENV_FILES=$(echo "${STAGED_FILES}" | grep -E '\.env($|\.)' || true)
if [ -n "${ENV_FILES}" ]; then
    echo ""
    echo "[PRE-COMMIT WARN] .env file detected in staging:"
    echo "${ENV_FILES}"
    echo ""
    echo "If intentional, use git commit --no-verify"
    echo "Otherwise: git rm --cached <file>"
fi

# --- Check 3: Large files (> 1MB) ---
LARGE_FILES=""
for file in ${STAGED_FILES}; do
    if [ -f "${file}" ]; then
        SIZE=$(stat -f%z "${file}" 2>/dev/null || stat -c%s "${file}" 2>/dev/null || echo 0)
        if [ "${SIZE}" -gt 1048576 ]; then
            LARGE_FILES="${LARGE_FILES}\n  ${file} ($(( SIZE / 1024 )) KB)"
        fi
    fi
done

if [ -n "${LARGE_FILES}" ]; then
    echo ""
    echo "[PRE-COMMIT WARN] Large files detected (> 1MB):"
    echo -e "${LARGE_FILES}"
    echo "Consider using Git LFS or .gitignore"
fi

echo "[PRE-COMMIT] Checks passed."

# --- Check 4: Encoding (CP1252 / Unicode) via pre-commit-encoding-check ---
REPO_ROOT=$(git rev-parse --show-toplevel)
ENCODING_HOOK="${REPO_ROOT}/.githooks/pre-commit-encoding-check"

if [ -f "${ENCODING_HOOK}" ]; then
    python "${ENCODING_HOOK}" 2>/dev/null || exit $?
fi

# --- Check 5: Post-implement friction check ---
POST_IMPL="${REPO_ROOT}/post_implement_check.py"
if [ -f "${POST_IMPL}" ]; then
    echo "[PRE-COMMIT] Running post-implement friction check..."
    python "${POST_IMPL}" --repo "${REPO_ROOT}" --fix 2>/dev/null
    POST_IMPL_STATUS=$?
    if [ ${POST_IMPL_STATUS} -ne 0 ]; then
        echo ""
        echo "[PRE-COMMIT WARN] Post-implement check found frictions."
        echo "  Re-run with --fix on post_implement_check.py to auto-correct."
        echo "  Or commit with --no-verify if intentional."
    fi
fi

# --- Check 6: Frontmatter validation for governance docs ---
FRONTMATTER_CHECK="${REPO_ROOT}/.githooks/validate_frontmatter.py"
if [ -f "${FRONTMATTER_CHECK}" ]; then
    echo "[PRE-COMMIT] Running frontmatter validation..."
    python "${FRONTMATTER_CHECK}" "${REPO_ROOT}" 2>/dev/null
    FM_STATUS=$?
    if [ ${FM_STATUS} -ne 0 ]; then
        echo ""
        echo "[PRE-COMMIT BLOCK] Frontmatter validation failed."
        echo "  Fix required fields and status values in affected docs."
        exit 1
    fi
fi

echo "[PRE-COMMIT] All checks passed."
