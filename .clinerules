version: "1.0"
ecosystem: "ecosystem-1"
role: "orchestration_projects"
priority: 1

rules:
  - name: "Intent Hash Mandatory"
    pattern: "^\\[KIVA-AUTO\\]|^\\[ECOS-AUTO\\]"
    scope: "commit_messages"
    enforcement: "strict"
  
  - name: "Tests Required"
    threshold: 0.80
    scope: "pull_requests"
    enforcement: "strict"
  
  - name: "Phi-CPS Tracking"
    validate: true
    scope: "deployments"
    threshold: 0.05

integrations:
  ecos_cli:
    registry_path: "../ECOYSTEM/tooling/ecos_cli/registry.json"
    wal_endpoint: "sqlite://ECOYSTEM/global_wal.db"
    delegation: "subprocess"
  
  brain_cli:
    optional: true
    coordination: "subprocess"
    commands:
      - "pattern"
      - "knowledge"
  
  fluence_cli:
    optional: true
    coordination: "subprocess"
    commands:
      - "workflow"
      - "execute"

dependencies:
  required:
    - "ECOYSTEM>=5.0.0"
  optional:
    - "BRAIN>=1.0.0"
    - "FLUENCE>=0.5.0"

ternary_states:
  validation:
    - "PENDING"
    - "VALID"
    - "INVALID"
  
  lifecycle:
    - "GENESIS"
    - "ACTIVE"
    - "DEPRECATED"
    - "ARCHIVED"
